		annotation SummarizationSetBy = Automatic

	partition F_GUS_Rok = m
		mode: import
		source =
				let
				    // Jedna tabela: kod | rok | wskaźniki (pivot po wskaznik), tylko 15 miast z D_Miasto
				    Kody = List.Buffer(D_Miasto[kod_gus]),
				    TylkoMiasta = Table.SelectRows(GUS_Surowe, each List.Contains(Kody, [Kod])),
				    BezNazwy = Table.RemoveColumns(TylkoMiasta, {"Nazwa"}),
				    Przestawione = Table.Pivot(BezNazwy, {"wynagrodzenie", "ludnosc", "bezrobocie", "saldo_migracji_na_1000", "mieszkania_oddane"}, "wskaznik", "Wartosc"),
				    // BDL podaje ludność w tysiącach
				    LudnoscOsoby = Table.TransformColumns(Przestawione, {{"ludnosc", each Number.Round(_ * 1000), type number}}),
				    ZMiastem = Table.NestedJoin(LudnoscOsoby, {"Kod"}, D_Miasto, {"kod_gus"}, "D_Miasto", JoinKind.LeftOuter),
				    Rozwiniete = Table.ExpandTableColumn(ZMiastem, "D_Miasto", {"city"}),
				    Zmienione = Table.RenameColumns(Rozwiniete, {{"Kod", "kod"}, {"Rok", "rok"}}),
				    Typy = Table.TransformColumnTypes(Zmienione, {{"wynagrodzenie", type number}, {"ludnosc", Int64.Type}, {"bezrobocie", type number}, {"saldo_migracji_na_1000", type number}, {"mieszkania_oddane", Int64.Type}, {"city", type text}}),
				    Kolejnosc = Table.ReorderColumns(Typy, {"kod", "city", "rok", "wynagrodzenie", "ludnosc", "bezrobocie", "saldo_migracji_na_1000", "mieszkania_oddane"})
				in
				    Kolejnosc

	annotation PBI_ResultType = Table

