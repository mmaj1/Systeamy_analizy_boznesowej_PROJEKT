	/// wiersz z ostatniego miesiąca, w którym wystąpiło dane id
	column ostatnia_oferta
		dataType: boolean
		lineageTag: 507a49ae-f547-537a-9dbf-be72e643933a
		summarizeBy: none
		sourceColumn: ostatnia_oferta

		annotation SummarizationSetBy = Automatic

	partition F_Sprzedaz = m
		mode: import
		source =
				let
				    // Oferty sprzedaży z Kaggle (price = cena ofertowa); separator dziesiętny: kropka (en-US)
				    Kolumny = {"id", "city", "type", "squareMeters", "rooms", "floor", "floorCount", "buildYear", "latitude", "longitude", "centreDistance", "poiCount", "schoolDistance", "clinicDistance", "postOfficeDistance", "kindergartenDistance", "restaurantDistance", "collegeDistance", "pharmacyDistance", "ownership", "buildingMaterial", "condition", "hasParkingSpace", "hasBalcony", "hasElevator", "hasSecurity", "hasStorageRoom", "price"},
				    Pliki = Folder.Files(SciezkaDanych),
				    PlikiKaggle = Table.SelectRows(Pliki, each Text.EndsWith(Text.Lower([Folder Path]), "\kaggle\") and Text.Lower([Extension]) = ".csv"),
				    PlikiFiltr = Table.SelectRows(PlikiKaggle, each not Text.Contains([Name], "rent")),
				    Wczytane = Table.AddColumn(PlikiFiltr, "Dane", each Table.Skip(Csv.Document([Content], [Delimiter = ",", Columns = Kolumny, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]), 1)),
				    Wybrane = Table.SelectColumns(Wczytane, {"Name", "Dane"}),
				    ZmienionaNazwa = Table.RenameColumns(Wybrane, {{"Name", "Source.Name"}}),
				    Rozwiniete = Table.ExpandTableColumn(ZmienionaNazwa, "Dane", Kolumny),
				    // miesiąc z nazwy pliku: apartments_..._2023_08.csv -> 2023-08-01
				    DodanyMiesiac = Table.AddColumn(Rozwiniete, "miesiac", each let s = Text.Start(Text.End([Source.Name], 11), 7) in #date(Number.From(Text.Start(s, 4)), Number.From(Text.End(s, 2)), 1), type date),
				    UsunietaNazwa = Table.RemoveColumns(DodanyMiesiac, {"Source.Name"}),
				    Typy = Table.TransformColumnTypes(UsunietaNazwa, {{"id", type text}, {"city", type text}, {"type", type text}, {"ownership", type text}, {"buildingMaterial", type text}, {"condition", type text}, {"squareMeters", type number}, {"latitude", type number}, {"longitude", type number}, {"centreDistance", type number}, {"schoolDistance", type number}, {"clinicDistance", type number}, {"postOfficeDistance", type number}, {"kindergartenDistance", type number}, {"restaurantDistance", type number}, {"collegeDistance", type number}, {"pharmacyDistance", type number}, {"price", type number}, {"rooms", Int64.Type}, {"floor", Int64.Type}, {"floorCount", Int64.Type}, {"buildYear", Int64.Type}, {"poiCount", Int64.Type}}, "en-US"),
				    // kolumny has*: tekst yes/no -> true/false
				    TakNie = Table.TransformColumns(Typy, List.Transform({"hasParkingSpace", "hasBalcony", "hasElevator", "hasSecurity", "hasStorageRoom"}, (c) => {c, (v) => if v = "yes" then true else if v = "no" then false else null, type logical})),
				    CenaM2 = Table.AddColumn(TakNie, "cena_m2", each [price] / [squareMeters], type number),
				    SegmentMetraz = Table.AddColumn(CenaM2, "segment_metraz", each if [squareMeters] < 40 then "<40" else if [squareMeters] < 60 then "40-60" else if [squareMeters] < 80 then "60-80" else ">80", type text),
				    SegmentMetrazNr = Table.AddColumn(SegmentMetraz, "segment_metraz_nr", each if [squareMeters] < 40 then 1 else if [squareMeters] < 60 then 2 else if [squareMeters] < 80 then 3 else 4, Int64.Type),
				    SegmentOdleglosc = Table.AddColumn(SegmentMetrazNr, "segment_odleglosc", each if [centreDistance] = null then null else if [centreDistance] < 2 then "<2 km" else if [centreDistance] < 5 then "2-5 km" else if [centreDistance] < 10 then "5-10 km" else ">10 km", type text),
				    SegmentOdlegloscNr = Table.AddColumn(SegmentOdleglosc, "segment_odleglosc_nr", each if [centreDistance] = null then null else if [centreDistance] < 2 then 1 else if [centreDistance] < 5 then 2 else if [centreDistance] < 10 then 3 else 4, Int64.Type),
				    NowyBudynek = Table.AddColumn(SegmentOdlegloscNr, "nowy_budynek", each if [buildYear] = null then null else [buildYear] >= 2020, type logical),
				    // deduplikacja: ta sama oferta (id) wraca w kolejnych miesiącach -> flaga ostatniego wystąpienia
				    OstatniMiesiac = Table.Group(NowyBudynek, {"id"}, {{"ostatni_miesiac", each List.Max([miesiac]), type date}}),
				    OstatniMiesiacKlucz = Table.RenameColumns(OstatniMiesiac, {{"id", "id_ostatni"}}),
				    Scalone = Table.Join(NowyBudynek, "id", OstatniMiesiacKlucz, "id_ostatni", JoinKind.LeftOuter),
				    OstatniaOferta = Table.AddColumn(Scalone, "ostatnia_oferta", each [miesiac] = [ostatni_miesiac], type logical),
				    Wynik = Table.RemoveColumns(OstatniaOferta, {"id_ostatni", "ostatni_miesiac"})
				in
				    Wynik

	annotation PBI_ResultType = Table

