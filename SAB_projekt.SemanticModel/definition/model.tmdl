model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SciezkaDanych", "D_Miasto", "D_Kalendarz", "D_Segment", "F_Sprzedaz", "F_Najem", "GUS_Surowe", "F_GUS_Rok", "_Miary"]

annotation PBI_ProTooling = ["DevMode"]

ref table D_Miasto
ref table D_Kalendarz
ref table D_Segment
ref table F_Sprzedaz
ref table F_Najem
ref table F_GUS_Rok
ref table _Miary

